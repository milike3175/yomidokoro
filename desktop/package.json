{
  "name": "yomidokoro-desktop",
  "productName": "yomidokoro",
  "version": "0.0.1",
  "private": true,
  "description": "よみどころ（試し版）。app/out をダブルクリックで開けるアプリにしたもの",
  "main": "main.cjs",
  "scripts": {
    "写す": "node scripts/copy-out.mjs",
    "start": "node scripts/copy-out.mjs && electron .",
    "様式を試す": "node scripts/copy-out.mjs && YOMIDOKORO_SHUTOKU=30 electron .",
    "書き出し:win": "node scripts/copy-out.mjs && electron-builder --win zip --x64",
    "書き出し:mac": "node scripts/copy-out.mjs && electron-builder --mac zip --arm64"
  },
  "devDependencies": {
    "electron": "45.2.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "jp.milike.yomidokoro",
    "productName": "yomidokoro",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**",
      "package.json"
    ],
    "extraResources": [
      { "from": "_写し/site", "to": "site" },
      { "from": "_写し/様式", "to": "様式の対応表" }
    ],
    "asar": true,
    "win": {
      "target": ["zip"],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": ["zip"],
      "identity": null,
      "category": "public.app-category.productivity"
    }
  }
}
