{
  "name": "yomidokoro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "TECHO=${TECHO:-1} next dev -H 127.0.0.1",
    "build": "TECHO=${TECHO:-0} next build && node scripts/build-check.ts",
    "確認": "node scripts/kakunin.ts",
    "取込": "node scripts/torikomi.ts",
    "取得": "node scripts/tebiki/shutoku.ts",
    "読む": "node scripts/tebiki/yomu.ts",
    "照合": "node scripts/tebiki/shogo.ts",
    "拾い直す": "node scripts/tebiki/hiroinaoshi.ts",
    "下書きを試す": "node scripts/shitagaki-tameshi.ts",
    "鮮度": "node scripts/tebiki/sendo.ts",
    "探す": "node scripts/hajimete/sagasu.ts",
    "はじめて読む": "node scripts/hajimete/yomu.ts",
    "判定": "node scripts/yure/hantei.ts",
    "見張り": "node scripts/kokai-mihari.ts",
    "見張りを入れる": "cp scripts/hooks/pre-push ../.git/hooks/pre-push && chmod +x ../.git/hooks/pre-push && echo pre-push に見張りを入れた"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "jszip": "3.10.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "typescript": "^5"
  }
}
